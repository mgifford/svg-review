   }
 }
 
@@ -61,12 +57,46 @@
 body:has([data-drupal-selector="edit-save"] + .ajax-progress) :where([data-drupal-selector="sticky-edit-save"]),
 body:has([data-drupal-selector="edit-preview"] + .ajax-progress) :where([data-drupal-selector="sticky-edit-preview"]),
 body:has([data-drupal-selector="edit-delete"] + .ajax-progress) :where([data-drupal-selector="sticky-edit-delete"]) {
+  position: relative;
   padding-inline-start: var(--admin-space-xl);
-  animation: pseudo-throbber 1s linear infinite;
-  background-image: var(--admin-icon-loader);
+
+  &::after {
+    position: absolute;
+    inset-block: 0;
+    inset-inline-start: 0;
+    width: 100%;
+    height: 100%;
+    background-color: currentColor;
+    -webkit-mask-image: var(--admin-icon-loader);
+    -webkit-mask-repeat: no-repeat;
+    -webkit-mask-position: 16px 18px;
+    -webkit-mask-size: 8px 8px;
+    mask-image: var(--admin-icon-loader);
+    mask-repeat: no-repeat;
+    mask-position: 16px 18px;
+    mask-size: 8px 8px;
+    animation: pseudo-throbber-mask 1s linear infinite;
+    content: "";
+    pointer-events: none;
+  }
 
   &:dir(rtl) {
     padding-inline-start: unset;
     padding-inline-end: var(--admin-space-xl);
+
+    &::after {
+      -webkit-mask-position: right 16px center;
+      mask-position: right 16px center;
+    }
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  body:has([data-drupal-selector="edit-save"] + .ajax-progress) :where([data-drupal-selector="sticky-edit-save"]),
+  body:has([data-drupal-selector="edit-preview"] + .ajax-progress) :where([data-drupal-selector="sticky-edit-preview"]),
+  body:has([data-drupal-selector="edit-delete"] + .ajax-progress) :where([data-drupal-selector="sticky-edit-delete"]) {
+    &::after {
+      animation: none;
+    }
   }
 }
